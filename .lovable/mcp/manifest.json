{
  "version": 1,
  "sdk_version": "0.25.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://mbqvgrfadxgvolkiyzlt.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "crt-training-console",
      "version": "0.1.0",
      "title": "CRT Training Console"
    },
    "tools": [
      {
        "name": "whoami",
        "title": "Who am I",
        "description": "Return the signed-in user's CRT profile and roles (admin, trainer, placement, student).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_modules",
        "title": "List syllabus modules",
        "description": "List the CRT curriculum modules and their topics, with completion state.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_students",
        "title": "List students",
        "description": "List student profiles visible to the signed-in user. Trainers, admins and the placement cell see the whole batch; students see only themselves.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "search": {
              "description": "Optional name or roll-number filter.",
              "type": "string",
              "maxLength": 100
            },
            "limit": {
              "description": "Max rows to return (default 50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_assessments",
        "title": "List assessments",
        "description": "List scheduled CRT assessments (weekly tests, mock NQT, coding tests, interviews).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "kind": {
              "description": "Optional assessment kind filter.",
              "type": "string",
              "enum": [
                "weekly_test",
                "mock_nqt",
                "coding_test",
                "interview"
              ]
            },
            "limit": {
              "description": "Max rows to return (default 50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_scores",
        "title": "Get assessment scores",
        "description": "Get assessment scores. Students see their own marks; trainers, admins and the placement cell can filter by student_id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "student_id": {
              "description": "Optional student profile user id to filter by.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "limit": {
              "description": "Max rows to return (default 100).",
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_assessment",
        "title": "Schedule an assessment",
        "description": "Schedule a new CRT assessment. Only trainers and admins are permitted by the database policies.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 3,
              "maxLength": 160,
              "description": "Assessment title."
            },
            "kind": {
              "type": "string",
              "enum": [
                "weekly_test",
                "mock_nqt",
                "coding_test",
                "interview"
              ],
              "description": "Type of assessment."
            },
            "max_marks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "description": "Maximum marks."
            },
            "scheduled_on": {
              "type": "string",
              "minLength": 4,
              "maxLength": 20,
              "description": "Scheduled date, YYYY-MM-DD."
            },
            "module_id": {
              "description": "Optional module this maps to.",
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "title",
            "kind",
            "max_marks",
            "scheduled_on"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "record_score",
        "title": "Record a student score",
        "description": "Record or update a student's marks for an assessment. Only trainers and admins are permitted by the database policies.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "student_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Student user id."
            },
            "assessment_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Assessment id."
            },
            "marks": {
              "type": "number",
              "minimum": 0,
              "maximum": 500,
              "description": "Marks obtained."
            },
            "attempts": {
              "description": "Attempt number (default 1).",
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          },
          "required": [
            "student_id",
            "assessment_id",
            "marks"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
